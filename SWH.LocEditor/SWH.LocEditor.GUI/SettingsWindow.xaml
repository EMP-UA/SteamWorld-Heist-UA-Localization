<Window x:Class="SWH.LocEditor.GUI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚙ Налаштування / Settings"
        Width="460" Height="250" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBase}"
        FontSize="{DynamicResource FontUI}">

    <!-- UA: Раніше це вікно взагалі не було темізоване — системний шрифт і
         типові WPF-кнопки (звідси "досі мілкий шрифт в налаштуваннях").
         Тепер FontSize вікна прив'язаний до FontUI (як і всюди в хромі
         програми), а кнопки використовують ті самі DarkBtn/PrimaryBtn
         стилі, що й головне вікно.
         EN: This window previously wasn't themed at all — system font and
         default WPF buttons (hence "settings font is still tiny"). Now the
         window's FontSize is bound to FontUI (same as the rest of the
         app's chrome), and the buttons use the same DarkBtn/PrimaryBtn
         styles as the main window. -->
    <StackPanel Margin="20">
        <TextBlock Text="Інтервал автозбереження (хв) / Autosave interval (minutes)"
                   FontWeight="SemiBold" FontSize="{DynamicResource FontUI}"
                   Foreground="{DynamicResource TextPrim}"
                   TextWrapping="Wrap"/>
        <TextBlock Text="0 = вимкнено / disabled. Тихо зберігає РОБОЧИЙ файл *_AUTOSAVE.tsv (усі 7 колонок вичитки) в review/, лише якщо є незбережена робота. / Silently saves the WORKING file *_AUTOSAVE.tsv (all 7 proofreading columns) into review/, only if there is unsaved work."
                   Foreground="{DynamicResource TextSec}"
                   FontSize="{DynamicResource FontTiny}" TextWrapping="Wrap" Margin="0,6,0,14"/>

        <TextBox x:Name="IntervalBox" Width="90" HorizontalAlignment="Left"
                 Style="{StaticResource DarkInput}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Скасувати / Cancel" Style="{StaticResource DarkBtn}"
                    Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="💾 Зберегти / Save" Style="{StaticResource PrimaryBtn}"
                    Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
